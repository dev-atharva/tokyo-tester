{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokyotester.dev/schemas/workflow-bundle/v2.json",
  "title": "Tokyo Tester workflow bundle",
  "type": "object",
  "required": ["schemaVersion", "kind", "workflow", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "cots.workflow-bundle" },
    "workflow": { "$ref": "#/$defs/workflow" },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
  },
  "additionalProperties": false,
  "$defs": {
    "workflow": {
      "type": "object",
      "required": ["name", "nodes", "edges"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "data"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "data": {
          "type": "object",
          "required": ["label", "service"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "service": { "$ref": "#/$defs/service" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "service": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["generic", "postgres", "mysql", "mariadb", "redis", "memcached", "mongodb", "rabbitmq", "kafka"] },
        "image": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" } },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "env": { "type": "array", "items": { "$ref": "#/$defs/env" } },
        "waitStratergy": { "$ref": "#/$defs/waitStrategy" },
        "initScripts": { "type": "array", "items": { "$ref": "#/$defs/initScript" } }
      },
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "required": ["hostPort", "containerPort"],
      "properties": {
        "id": { "type": "string" },
        "hostPort": { "type": "string" },
        "containerPort": { "type": "string" }
      },
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "required": ["key", "value"],
      "properties": { "id": { "type": "string" }, "key": { "type": "string" }, "value": { "type": "string" } },
      "additionalProperties": false
    },
    "waitStrategy": {
      "type": "object",
      "required": ["enabled", "type"],
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "enum": ["log", "port", "exec"] },
        "target": { "type": "string" },
        "timeout": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "initScript": {
      "type": "object",
      "required": ["order", "script"],
      "properties": {
        "id": { "type": "string" }, "order": { "type": "integer" }, "script": { "type": "string" }, "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "data"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "data": {
          "type": "object",
          "required": ["relation", "readiness"],
          "properties": {
            "relation": { "enum": ["calls", "reads", "writes", "publishes", "consumes"] },
            "readiness": { "enum": ["none", "source_requires_target", "target_requires_source"] },
            "label": { "type": "string" }, "description": { "type": "string" }, "protocol": { "type": "string" }, "needsReview": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "scenario": {
      "type": "object",
      "required": ["name", "tests", "testOrder"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" } },
        "testOrder": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "required": ["id", "name", "type", "targetServices"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["http", "database", "document", "cache", "queue", "shell", "delay"] },
        "targetServices": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "dependsOnTestIds": { "type": "array", "items": { "type": "string" } },
        "httpConfig": { "$ref": "#/$defs/httpConfig" },
        "databaseConfig": { "$ref": "#/$defs/databaseConfig" },
        "documentConfig": { "$ref": "#/$defs/documentConfig" },
        "cacheConfig": { "$ref": "#/$defs/cacheConfig" },
        "queueConfig": { "$ref": "#/$defs/queueConfig" },
        "shellConfig": { "$ref": "#/$defs/shellConfig" },
        "delayConfig": { "$ref": "#/$defs/delayConfig" }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "const": "http" } } }, "then": { "required": ["httpConfig"] } },
        { "if": { "properties": { "type": { "const": "database" } } }, "then": { "required": ["databaseConfig"] } },
        { "if": { "properties": { "type": { "const": "document" } } }, "then": { "required": ["documentConfig"] } },
        { "if": { "properties": { "type": { "const": "cache" } } }, "then": { "required": ["cacheConfig"] } },
        { "if": { "properties": { "type": { "const": "queue" } } }, "then": { "required": ["queueConfig"] } },
        { "if": { "properties": { "type": { "const": "shell" } } }, "then": { "required": ["shellConfig"] } },
        { "if": { "properties": { "type": { "const": "delay" } } }, "then": { "required": ["delayConfig"] } }
      ]
    },
    "httpConfig": {
      "type": "object",
      "required": ["method", "path", "port"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
        "path": { "type": "string", "pattern": "^/" },
        "port": { "type": "string", "pattern": "^[0-9]{1,5}(/tcp)?$" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": { "type": "string" },
        "expectedStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "expectedBody": {
          "type": "object",
          "required": ["mode", "value"],
          "properties": { "mode": { "enum": ["contains", "json_partial", "json"] }, "value": {} },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "databaseConfig": {
      "type": "object",
      "required": ["driver", "database", "query"],
      "properties": {
        "driver": { "enum": ["postgres", "mysql", "mariadb"] },
        "database": { "type": "string", "minLength": 1 },
        "user": { "type": "string" },
        "password": { "type": "string", "description": "Use only test-safe credentials; never production secrets." },
        "query": { "type": "string", "minLength": 1 },
        "expectedResult": {}
      },
      "additionalProperties": false
    },
    "documentConfig": {
      "type": "object",
      "required": ["service", "database", "collection", "operation"],
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "collection": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["insert_one", "find_one", "find_many", "update_one", "delete_one", "count_documents", "exists"] },
        "document": { "type": "object" }, "filter": { "type": "object" }, "update": { "type": "object" },
        "expectedDocument": { "type": "object" }, "expectedDocuments": { "type": "array", "items": { "type": "object" } },
        "expectedCount": { "type": "integer", "minimum": 0 }, "expectedExists": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "cacheConfig": {
      "type": "object",
      "required": ["service", "cacheType", "operation"],
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "cacheType": { "enum": ["redis", "memcached"] },
        "operation": { "enum": ["ping", "set", "get", "exists", "delete", "del"] },
        "key": { "type": "string" }, "value": {}, "expectedValue": {}, "expectedExists": { "type": "boolean" },
        "ttl": { "type": "integer", "minimum": 0 }, "db": { "type": "integer", "minimum": 0 },
        "password": { "type": "string", "description": "Use only test-safe credentials; never production secrets." }
      },
      "additionalProperties": false
    },
    "queueConfig": {
      "type": "object",
      "required": ["service", "brokerType", "operation"],
      "properties": {
        "service": { "type": "string", "minLength": 1 }, "brokerType": { "enum": ["kafka", "rabbitmq"] },
        "operation": { "enum": ["produce", "consume", "produce_and_consume", "check_topic", "list_topics"] },
        "topic": { "type": "string" }, "message": {}, "key": { "type": "string" }, "partition": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "integer", "minimum": 0, "maximum": 300 }, "fromBeginning": { "type": "boolean" },
        "expectedCount": { "type": "integer", "minimum": 0 }, "expectedMessage": {}, "expectedExists": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "shellConfig": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "expectedOutput": { "type": "string" }, "expectedExitCode": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "delayConfig": {
      "type": "object",
      "required": ["durationMs"],
      "properties": { "durationMs": { "type": "integer", "minimum": 1, "maximum": 86400000 } },
      "additionalProperties": false
    }
  }
}
