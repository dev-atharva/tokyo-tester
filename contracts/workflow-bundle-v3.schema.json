{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokyotester.dev/schemas/workflow-bundle/v3.json",
  "title": "Tokyo Tester workflow bundle v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "workflow",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "kind": {
      "const": "cots.workflow-bundle"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "workflow": {
      "type": "object",
      "required": [
        "name",
        "nodes",
        "edges"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "required": [
            "label",
            "service"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "service": {
              "$ref": "#/$defs/service"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "service": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "generic",
            "postgres",
            "mysql",
            "mariadb",
            "redis",
            "memcached",
            "mongodb",
            "rabbitmq",
            "kafka",
            "nginx",
            "mockserver"
          ]
        },
        "image": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "env": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/env"
          }
        },
        "waitStratergy": {
          "$ref": "#/$defs/waitStrategy"
        },
        "initScripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/initScript"
          }
        },
        "mockServer": {
          "$ref": "#/$defs/mockServer"
        },
        "registry": {
          "$ref": "#/$defs/registry"
        }
      },
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "required": [
        "hostPort",
        "containerPort"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "hostPort": {
          "type": "string"
        },
        "containerPort": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "waitStrategy": {
      "type": "object",
      "required": [
        "enabled",
        "type"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "log",
            "port",
            "exec"
          ]
        },
        "target": {
          "type": "string"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "initScript": {
      "type": "object",
      "required": [
        "order",
        "script"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "script": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mockServer": {
      "type": "object",
      "required": [
        "expectations"
      ],
      "properties": {
        "expectations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mockServerExpectation"
          }
        }
      },
      "additionalProperties": false
    },
    "mockServerExpectation": {
      "type": "object",
      "required": [
        "id",
        "request",
        "response"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "type": "object",
          "required": [
            "method",
            "path"
          ],
          "properties": {
            "method": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "HEAD",
                "OPTIONS"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "required": [
            "statusCode"
          ],
          "properties": {
            "statusCode": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "source",
        "target",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "required": [
            "relation",
            "readiness"
          ],
          "properties": {
            "relation": {
              "enum": [
                "calls",
                "reads",
                "writes",
                "publishes",
                "consumes"
              ]
            },
            "readiness": {
              "enum": [
                "none",
                "source_requires_target",
                "target_requires_source"
              ]
            },
            "label": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "protocol": {
              "type": "string"
            },
            "needsReview": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "scenario": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyScenario"
        },
        {
          "$ref": "#/$defs/journeyScenario"
        }
      ]
    },
    "test": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "targetServices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "http",
            "database",
            "document",
            "cache",
            "queue",
            "shell",
            "delay"
          ]
        },
        "targetServices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "dependsOnTestIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "httpConfig": {
          "$ref": "#/$defs/httpConfig"
        },
        "databaseConfig": {
          "$ref": "#/$defs/databaseConfig"
        },
        "documentConfig": {
          "$ref": "#/$defs/documentConfig"
        },
        "cacheConfig": {
          "$ref": "#/$defs/cacheConfig"
        },
        "queueConfig": {
          "$ref": "#/$defs/queueConfig"
        },
        "shellConfig": {
          "$ref": "#/$defs/shellConfig"
        },
        "delayConfig": {
          "$ref": "#/$defs/delayConfig"
        },
        "retryPolicy": {
          "$ref": "#/$defs/retryPolicy"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "httpConfig"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "database"
              }
            }
          },
          "then": {
            "required": [
              "databaseConfig"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "document"
              }
            }
          },
          "then": {
            "required": [
              "documentConfig"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cache"
              }
            }
          },
          "then": {
            "required": [
              "cacheConfig"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "queue"
              }
            }
          },
          "then": {
            "required": [
              "queueConfig"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "shell"
              }
            }
          },
          "then": {
            "required": [
              "shellConfig"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "delay"
              }
            }
          },
          "then": {
            "required": [
              "delayConfig"
            ]
          }
        }
      ]
    },
    "httpConfig": {
      "type": "object",
      "required": [
        "method",
        "path",
        "port"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "port": {
          "type": "string",
          "pattern": "^[0-9]{1,5}(/tcp)?$"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "string"
        },
        "expectedStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "expectedBody": {
          "type": "object",
          "required": [
            "mode",
            "value"
          ],
          "properties": {
            "mode": {
              "enum": [
                "contains",
                "json_partial",
                "json"
              ]
            },
            "value": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "databaseConfig": {
      "type": "object",
      "required": [
        "driver",
        "database",
        "query"
      ],
      "properties": {
        "driver": {
          "enum": [
            "postgres",
            "mysql",
            "mariadb"
          ]
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string",
          "description": "Use only test-safe credentials; never production secrets."
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "expectedResult": {}
      },
      "additionalProperties": false
    },
    "documentConfig": {
      "type": "object",
      "required": [
        "service",
        "database",
        "collection",
        "operation"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "insert_one",
            "find_one",
            "find_many",
            "update_one",
            "delete_one",
            "count_documents",
            "exists"
          ]
        },
        "document": {
          "type": "object"
        },
        "filter": {
          "type": "object"
        },
        "update": {
          "type": "object"
        },
        "expectedDocument": {
          "type": "object"
        },
        "expectedDocuments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "expectedCount": {
          "type": "integer",
          "minimum": 0
        },
        "expectedExists": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "cacheConfig": {
      "type": "object",
      "required": [
        "service",
        "cacheType",
        "operation"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "cacheType": {
          "enum": [
            "redis",
            "memcached"
          ]
        },
        "operation": {
          "enum": [
            "ping",
            "set",
            "get",
            "exists",
            "delete",
            "del"
          ]
        },
        "key": {
          "type": "string"
        },
        "value": {},
        "expectedValue": {},
        "expectedExists": {
          "type": "boolean"
        },
        "ttl": {
          "type": "integer",
          "minimum": 0
        },
        "db": {
          "type": "integer",
          "minimum": 0
        },
        "password": {
          "type": "string",
          "description": "Use only test-safe credentials; never production secrets."
        }
      },
      "additionalProperties": false
    },
    "queueConfig": {
      "type": "object",
      "required": [
        "service",
        "brokerType",
        "operation"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "brokerType": {
          "enum": [
            "kafka",
            "rabbitmq"
          ]
        },
        "operation": {
          "enum": [
            "produce",
            "consume",
            "produce_and_consume",
            "check_topic",
            "list_topics"
          ]
        },
        "topic": {
          "type": "string"
        },
        "message": {},
        "key": {
          "type": "string"
        },
        "partition": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "fromBeginning": {
          "type": "boolean"
        },
        "expectedCount": {
          "type": "integer",
          "minimum": 0
        },
        "expectedMessage": {},
        "expectedExists": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "shellConfig": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "expectedOutput": {
          "type": "string"
        },
        "expectedExitCode": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "delayConfig": {
      "type": "object",
      "required": [
        "durationMs"
      ],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      },
      "additionalProperties": false
    },
    "legacyScenario": {
      "type": "object",
      "required": [
        "name",
        "executionModel",
        "tests",
        "testOrder"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "executionModel": {
          "const": "legacy-tests"
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "testOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "journeyScenario": {
      "type": "object",
      "required": [
        "name",
        "executionModel",
        "environment",
        "steps",
        "stepOrder"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "executionModel": {
          "const": "journey"
        },
        "environment": {
          "$ref": "#/$defs/journeyEnvironment"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scenarioStep"
          }
        },
        "stepOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "journeyEnvironment": {
      "type": "object",
      "required": [
        "driver",
        "browser"
      ],
      "properties": {
        "driver": {
          "const": "browser"
        },
        "browser": {
          "$ref": "#/$defs/browserEnvironment"
        }
      },
      "additionalProperties": false
    },
    "browserEnvironment": {
      "type": "object",
      "required": [
        "targetService",
        "targetPort"
      ],
      "properties": {
        "targetService": {
          "type": "string",
          "minLength": 1
        },
        "targetPort": {
          "type": "string",
          "pattern": "^[0-9]{1,5}(/tcp)?$"
        }
      },
      "additionalProperties": false
    },
    "scenarioStep": {
      "oneOf": [
        {
          "$ref": "#/$defs/actionStep"
        },
        {
          "$ref": "#/$defs/assertionStep"
        },
        {
          "$ref": "#/$defs/controlStep"
        }
      ]
    },
    "actionStep": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "kind": {
          "const": "action"
        },
        "action": {
          "$ref": "#/$defs/browserAction"
        }
      },
      "additionalProperties": false
    },
    "assertionStep": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "assertion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "kind": {
          "const": "assertion"
        },
        "assertion": {
          "$ref": "#/$defs/browserAssertion"
        }
      },
      "additionalProperties": false
    },
    "controlStep": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "control"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        },
        "kind": {
          "const": "control"
        },
        "control": {
          "$ref": "#/$defs/stepControl"
        }
      },
      "additionalProperties": false
    },
    "browserAction": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "operation",
            "path"
          ],
          "properties": {
            "operation": {
              "const": "navigate"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "locator",
            "value"
          ],
          "properties": {
            "operation": {
              "const": "fill"
            },
            "locator": {
              "$ref": "#/$defs/browserLocator"
            },
            "value": {
              "$ref": "#/$defs/stepValue"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "locator"
          ],
          "properties": {
            "operation": {
              "const": "click"
            },
            "locator": {
              "$ref": "#/$defs/browserLocator"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "browserAssertion": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "operation",
            "path"
          ],
          "properties": {
            "operation": {
              "const": "url"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "query": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "locator"
          ],
          "properties": {
            "operation": {
              "const": "visible"
            },
            "locator": {
              "$ref": "#/$defs/browserLocator"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "stepControl": {
      "type": "object",
      "required": [
        "operation",
        "durationMs"
      ],
      "properties": {
        "operation": {
          "const": "delay"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      },
      "additionalProperties": false
    },
    "browserLocator": {
      "oneOf": [
        {
