{$TOKYO_TESTER_DOMAIN:localhost} {
	encode zstd gzip

	respond /api/v1/agent/introspect 404

	@logs path /logs /logs/*
	handle @logs {
		reverse_proxy observability:8080 {
			flush_interval -1
		}
	}

	handle /mcp* {
		request_body {
			max_size 2MB
		}
		reverse_proxy mcp:8090
	}

	handle /api/v1/workflow-runs {
		request_body {
			max_size 5MB
		}
		reverse_proxy ui:3000
	}

	handle {
		reverse_proxy ui:3000
	}
}
