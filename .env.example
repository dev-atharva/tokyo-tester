# Production requires externally managed MySQL. The runner and UI use separate
# databases and run their own forward migrations during application startup.
APP_ENV=development
LOG_LEVEL=debug
PORT=8080
OTEL_ENABLED=false
CORS_ORIGIN=http://localhost:3000
RUNNER_DB_TYPE=mysql
UI_DB_TYPE=mysql
# URL-encode usernames and passwords.
RUNNER_DATABASE_URL=mysql://tokyo:replace-with-url-encoded-password@mysql.example.internal:3306/tokyo_runner
UI_DATABASE_URL=mysql://tokyo:replace-with-url-encoded-password@mysql.example.internal:3306/tokyo_ui

# Development-only credentials for the local MySQL service in
# docker-compose.dev.yml. Production does not use these values.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-long-url-safe-app-password

# Optional external database backup settings used by `make prod-backup`.
# Prefer a dedicated backup user and TLS. Provider snapshots can be used instead.
MYSQL_BACKUP_HOST=mysql.example.internal
MYSQL_BACKUP_PORT=3306
MYSQL_BACKUP_USER=tokyo_backup
MYSQL_BACKUP_PASSWORD=replace-with-a-long-backup-password
MYSQL_BACKUP_SSL_MODE=REQUIRED
# MYSQL_BACKUP_IMAGE=mysql:8.4
# MYSQL_RUNNER_DATABASE=tokyo_runner
# MYSQL_UI_DATABASE=tokyo_ui

# Auth.js (ui-v2)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
# AUTH_URL=http://localhost:3000

# Public edge and remote MCP
TOKYO_TESTER_DOMAIN=localhost
# Temporary private testing only. When true, use http:// consistently for
# TOKYO_TESTER_DOMAIN, all public URLs, AUTH_URL, and CORS_ORIGIN.
ALLOW_INSECURE_HTTP=false
# Full public origin used by production verification.
# TOKYO_TESTER_PUBLIC_URL=https://tokyo-tester.example.com
# Set this to the exact public origin to reject unexpected browser origins.
# TOKYO_TESTER_PUBLIC_ORIGIN=https://tokyo-tester.example.com

# MCP authorization. Use oauth for internet-facing/user-registration deployments.
# Use personal_token only for controlled self-hosted installations with trusted users.
MCP_AUTH_MODE=personal_token
MCP_INTERNAL_SECRET=replace-with-a-separate-long-random-secret
# MCP_PUBLIC_URL defaults to TOKYO_TESTER_PUBLIC_ORIGIN + /mcp.
# MCP_PUBLIC_URL=https://tokyo-tester.example.com/mcp
# Required when MCP_AUTH_MODE=oauth. The provider must support RFC 7662
# introspection and issue tokens whose audience is the per-project MCP URL.
# MCP_OAUTH_ISSUER=https://identity.example.com
# MCP_OAUTH_INTROSPECTION_URL=https://identity.example.com/oauth2/introspect
# MCP_OAUTH_CLIENT_ID=
# MCP_OAUTH_CLIENT_SECRET=

# Embedded MySQL workflow worker. Generate the encryption key with:
# openssl rand -base64 32
WORKFLOW_WORKER_ENABLED=true
WORKFLOW_WORKER_CONCURRENCY=2
WORKFLOW_SCENARIO_CONCURRENCY=1
WORKFLOW_MAX_QUEUED_GLOBAL=100
WORKFLOW_MAX_QUEUED_PER_USER=3
WORKFLOW_MAX_QUEUED_PER_PROJECT=10
WORKFLOW_SUBMISSIONS_PER_MINUTE_USER=10
WORKFLOW_SUBMISSIONS_PER_MINUTE_PROJECT=60
WORKFLOW_MAX_RUNNING_PER_USER=1
WORKFLOW_MAX_RUNNING_PER_PROJECT=2
WORKFLOW_CONTAINER_MEMORY_MB=1024
WORKFLOW_CONTAINER_CPU_MILLI=1000
WORKFLOW_CONTAINER_PIDS=256
WORKFLOW_JOB_LEASE_SECONDS=60
WORKFLOW_JOB_HEARTBEAT_SECONDS=15
WORKFLOW_JOB_MAX_RECOVERIES=3
WORKFLOW_EVENT_RETENTION_DAYS=30
WORKFLOW_JOB_ENCRYPTION_KEY=

# Zero disables the per-test deadline for legitimately long workflows.
TEST_RUN_TIMEOUT_SEC=0

# Optional override when the runner cannot reach mapped container ports
# TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal
# Optional Docker socket path; `make dev` auto-detects it when unset
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# Optional override only if you need a non-default in-container Docker socket path
# CONTAINER_DOCKER_SOCKET_PATH=/var/run/docker.sock
# Optional override only if the runner container needs a non-default Docker Host
# RUNNER_DOCKER_HOST=unix:///var/run/docker.sock
# Optional override used by `make dev` when it falls back to a host runner
# HOST_RUNNER_API_URL=http://host.docker.internal:8080
